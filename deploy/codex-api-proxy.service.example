[Unit]
Description=Codex CLI OpenAI-compatible API proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPLACE_WITH_PROJECT_DIRECTORY
Environment=HOME=REPLACE_WITH_HOME_DIRECTORY
Environment=PATH=REPLACE_WITH_NODE_BIN_DIRECTORY:REPLACE_WITH_HOME_DIRECTORY/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-REPLACE_WITH_HOME_DIRECTORY/.config/codex-api-proxy/env
Environment=CODEX_PONYTAIL_DEFAULT=off
Environment=CODEX_ATTACHMENT_MAX_EXTRACTED_BYTES=2097152
Environment=CODEX_ATTACHMENT_EXTRACTION_TIMEOUT_MS=15000
Environment=CODEX_ATTACHMENT_MAX_PDF_PAGES=50
Environment=CODEX_ATTACHMENT_MAX_ARCHIVE_ENTRIES=100
Environment=CODEX_ATTACHMENT_MAX_ARCHIVE_DEPTH=2
Environment=CODEX_ATTACHMENT_MAX_SPREADSHEET_ROWS=200
Environment=CODEX_ATTACHMENT_MAX_VIDEO_FRAMES=4
Environment=CODEX_ATTACHMENT_ENABLE_MEDIA_EXTRACTION=false
Environment=CODEX_ATTACHMENT_RENDER_PDF_IMAGES=false
ExecStart=REPLACE_WITH_NODE_EXECUTABLE REPLACE_WITH_PROJECT_DIRECTORY/dist/server/standalone.js 3456
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
